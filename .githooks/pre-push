#!/bin/bash
# Pre-push hook: Block push if code coverage is below threshold
#
# To install this hook, run:
#   git config core.hooksPath .githooks
# Or:
#   make setup-hooks

set -e

# Get the root of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Check if we should skip coverage check
if [ "$SKIP_COVERAGE_CHECK" = "1" ]; then
    echo "⚠️  Skipping coverage check (SKIP_COVERAGE_CHECK=1)"
    exit 0
fi

# Run the coverage check script
echo "🔒 Pre-push hook: Checking code coverage..."
echo ""

bash scripts/check_coverage.sh

exit $?
